{
    "name": "@beatoz/web3-validator",
    "version": "1.6.5",
    "main": "./lib/esm/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "license": "Apache-2.0",
    "keywords": [
        "beatoz",
        "sdk",
        "blockchain",
        "dapp"
    ],
    "homepage": "https://github.com/beatoz/beatoz-sdk-js",
    "author": {
        "name": "BEATOZ Team",
        "email": "dev@beatoz.io",
        "url": "https://github.com/beatoz"
    },
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=8.19.0"
    },
    "scripts": {
        "clean": "rimraf dist && rimraf lib",
        "prebuild": "yarn clean",
        "build": "yarn version:output && yarn build:esm && yarn build:types",
        "version:output": "[ -z $npm_package_version ] && rm ./src/version.ts || echo \"/* eslint-disable license-header/header */ export const Web3PkgInfo = { version: '$npm_package_version' };\" > ./src/version.ts",
        "build:esm": "tsc --build tsconfig.json && echo '{\"type\": \"module\"}' > ./lib/esm/package.json",
        "build:types": "tsc --build tsconfig.types.json",
        "build:web": "npx webpack",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write '**/*'",
        "test": "jest --config=./test/unit/jest.config.js",
        "test:silent": "jest --silent --config=./test/unit/jest.config.js"
    },
    "devDependencies": {
        "@openzeppelin/contracts": "^4.7.1",
        "@types/jest": "^28.1.6",
        "@types/node": "22.20.2",
        "jest": "^28.1.3",
        "jest-extended": "^3.0.1",
        "prettier": "^3.0.0",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@beatoz/web3-errors": "^1.6.5",
        "@beatoz/web3-types": "^1.6.5",
        "ethereum-cryptography": "2.1.2",
        "is-my-json-valid": "^2.20.6",
        "util": "^0.12.5"
    },
    "peerDependencies": {
        "typescript": ">=5.4"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    }
}
