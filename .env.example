# Integration test configuration.
#
# Integration tests need a reachable node and funded accounts. This repository
# does not ship either, and makes no assumption about where they come from.
#
# Copy this file to .env and fill it in. .env is gitignored - never commit
# real keys.

# Node endpoints. The defaults below are the standard Tendermint RPC ports on
# localhost, and are the only values that have a default.
# BEATOZ_RPC_URL=http://localhost:26657
# BEATOZ_WS_URL=ws://localhost:26657/websocket

# Chain id. It goes into the signing preimage and must match what the node
# reports as node_info.network, or transactions are rejected as
# `invalid signature` with nothing pointing at the real cause.
BEATOZ_CHAIN_ID=

# A funded account. Tests sign and broadcast real transactions with it, so it
# needs a balance on the target chain.
BEATOZ_TEST_ADDRESS=
BEATOZ_TEST_PRIVATE_KEY=

# A second funded account, for tests that need two distinct signers.
BEATOZ_TEST_PROPOSAL_ADDRESS=
BEATOZ_TEST_PROPOSAL_PRIVATE_KEY=
