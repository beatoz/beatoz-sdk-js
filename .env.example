# Integration test configuration.
#
# Integration tests need a reachable node and funded accounts.
#
#   yarn node:start
#
# starts one from the published beatoz/beatoz-re image, pinned by digest in
# scripts/testnode.config.json, and writes .env for you. That image prints ten
# funded wallet keys on startup and says to use them for nothing else; it makes
# new ones whenever it initialises a fresh chain, which is why .env is
# generated rather than kept, and why it is gitignored.
#
# This file is for pointing the tests somewhere else - a shared testnet, say.
# Copy it to .env and fill it in. Values already in the environment win over
# the file, so CI can supply them without one.

# Node endpoints. The defaults below are the standard Tendermint RPC ports on
# localhost, and are the only values that have a default.
# BEATOZ_RPC_URL=http://localhost:26657
# BEATOZ_WS_URL=ws://localhost:26657/websocket

# Chain id. It goes into the signing preimage and must match what the node
# reports as node_info.network, or transactions are rejected as
# `invalid signature` with nothing pointing at the real cause.
BEATOZ_CHAIN_ID=

# A funded account. Tests sign and broadcast real transactions with it, so it
# needs a balance on the target chain.
BEATOZ_TEST_ADDRESS=
BEATOZ_TEST_PRIVATE_KEY=

# A second funded account, for tests that need two distinct signers.
BEATOZ_TEST_PROPOSAL_ADDRESS=
BEATOZ_TEST_PROPOSAL_PRIVATE_KEY=

# The reward node, for `yarn test:reward` only. Those tests withdraw a staking
# reward, and the chain issues one every inflationCycleBlocks - a week of
# blocks by default - so they need a node with a short cycle:
#
#   yarn node:start:reward
#
# runs the same image with that one genesis value lowered and writes these to
# .env.reward, which is gitignored for the same reason .env is.
# BEATOZ_REWARD_RPC_URL=
# BEATOZ_REWARD_WS_URL=
# BEATOZ_REWARD_CHAIN_ID=
# BEATOZ_REWARD_ADDRESS=
# BEATOZ_REWARD_PRIVATE_KEY=
